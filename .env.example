# SINKRA OPS Cohort V5 — env vars opcionais
# Copie para .env (gitignored) se quiser sobrescrever defaults.

# Nome da empresa/processo que voce vai mapear (default: prompt interativo)
# SINKRA_COMPANY_NAME=minha-empresa

# Base path para outputs (default: workspace/output/)
# OUTPUT_BASE_PATH=./workspace/output

# Verbose para logs de cohort-bootstrap (default: 0)
# COHORT_BOOTSTRAP_VERBOSE=1

# ── ClickUp — materializacao do seu processo no SEU workspace (Forja Stage 3c) ──
# Usado pela Forja (/sinkra-create-skill) para materializar o processo mapeado
# (Lists, Custom Fields, status, Docs) no SEU ClickUp.
# Token (CLICKUP_API_KEY): ClickUp -> Settings -> Apps -> API Token -> "Generate" (pk_...).
# Team id (CLICKUP_TEAM_ID): o numero na URL https://app.clickup.com/<TEAM_ID>/...
# Sem estas chaves, a materializacao roda em modo mock (a geracao de skills funciona).
CLICKUP_API_KEY=
CLICKUP_TEAM_ID=
# Opcional — SOT de tokenization (idempotencia; evita recriar o ja materializado):
# SINKRA_CLICKUP_TOKENIZATION=
